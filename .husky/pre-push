# =============================================================================
# Pre-push Hook: Run Tests
# =============================================================================
# Runs before pushing to ensure all tests pass

echo "🧪 Running pre-push checks..."

# Get the current branch
branch=$(git rev-parse --abbrev-ref HEAD)

echo "📌 Pushing to branch: $branch"

# Run frontend tests (backend moved to andrelair-platform/retrieva-backend)
echo "🔬 Running frontend tests..."
cd frontend && npm run test:run || {
  echo ""
  echo "❌ Frontend tests failed! Push aborted."
  echo "Please fix failing tests before pushing."
  exit 1
}
cd ..

echo "✅ All tests passed! Proceeding with push..."
