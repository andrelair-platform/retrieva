{
  "name": "retrieva",
  "version": "1.0.0",
  "description": "Retrieva frontend — Next.js UI for the DORA TPRM / RAG platform (backend lives in andrelair-platform/retrieva-backend)",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "frontend": "npm --prefix frontend",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:lint": "npm --prefix frontend run lint",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test",
    "test:ci": "npm --prefix frontend test -- --run"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "eslint --fix --config frontend/eslint.config.mjs"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreLiar/Retrieva.git"
  },
  "author": "",
  "license": "ISC"
}
